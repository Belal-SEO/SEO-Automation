# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (report drafting AND crawl issue analysis --
# for Supabase Edge Functions this must also be set via `supabase secrets set`,
# separately from Vercel's env vars)
ANTHROPIC_API_KEY=

# PageSpeed Insights / CrUX (optional -- Core Web Vitals only, crawl issue
# detection itself doesn't need this)
PAGESPEED_API_KEY=

# Vercel Cron auth (protects /api/cron/*)
CRON_SECRET=

# Alerting (e.g. Slack incoming webhook) for alert-check
ALERT_WEBHOOK_URL=

# Google Workspace (Gmail + Drive delivery, and Search Console for Monthly
# Reports). The refresh token must be re-generated with these scopes:
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/drive.file
#   https://www.googleapis.com/auth/webmasters.readonly   <- needed for Monthly Reports' GSC pull
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_REPORTS_FOLDER_ID=
