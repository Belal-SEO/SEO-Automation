# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (report drafting AND crawl issue analysis --
# for Supabase Edge Functions this must also be set via `supabase secrets set`,
# separately from Vercel's env vars)
ANTHROPIC_API_KEY=

# PageSpeed Insights / CrUX (optional -- Core Web Vitals only, crawl issue
# detection itself doesn't need this)
PAGESPEED_API_KEY=

# Vercel Cron auth (protects /api/cron/*)
CRON_SECRET=

# Alerting (e.g. Slack incoming webhook) for alert-check
ALERT_WEBHOOK_URL=

# Where the Monthly Reports daily review-reminder cron emails the operator
NOTIFY_EMAIL=

# WP Remote (BlogVault API v6) -- malware/vulnerability/update security sync.
# Generate from WP Remote's dashboard under My Account > API Credentials.
WP_REMOTE_API_KEY=

# OpenRouter -- powers "Import audit report" (PDF/HTML upload -> extracted
# tasks) on the client detail page. Get a key from https://openrouter.ai/keys.
# OPENROUTER_MODEL must be an OpenRouter model slug, e.g.
# anthropic/claude-3.5-sonnet or openai/gpt-4o -- no default is set on purpose,
# pick the model explicitly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Workspace (Gmail + Drive delivery, and Search Console / Sheets /
# Business Profile for Monthly Reports). The refresh token must be
# re-generated with these scopes:
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/drive.file
#   https://www.googleapis.com/auth/webmasters.readonly     <- GSC pull
#   https://www.googleapis.com/auth/spreadsheets.readonly   <- backlinks Sheet pull
#   https://www.googleapis.com/auth/business.manage         <- GBP posts pull (also needs
#                                                                Google's GBP API access approval
#                                                                on the account -- see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_REPORTS_FOLDER_ID=
