# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (report drafting only -- crawl issue analysis now goes
# through OpenRouter, see below -- for Supabase Edge Functions this must also
# be set via `supabase secrets set`, separately from Vercel's env vars)
ANTHROPIC_API_KEY=

# PageSpeed Insights / CrUX (optional -- Core Web Vitals only, crawl issue
# detection itself doesn't need this)
PAGESPEED_API_KEY=

# Vercel Cron auth (protects /api/cron/*)
CRON_SECRET=

# Alerting (e.g. Slack incoming webhook) for alert-check
ALERT_WEBHOOK_URL=

# Where the Monthly Reports daily review-reminder cron emails the operator
NOTIFY_EMAIL=

# WP Remote (BlogVault API v6) -- malware/vulnerability/update security sync.
# Generate from WP Remote's dashboard under My Account > API Credentials.
WP_REMOTE_API_KEY=

# OpenRouter -- powers "Import audit report" (PDF/HTML upload -> extracted
# tasks) on the client detail page, AND crawl issue analysis for "Run crawl
# now" (model picked per run in that dropdown; OPENROUTER_MODEL below is only
# the fallback the monthly cron uses, since it has no UI to pick from). Get a
# key from https://openrouter.ai/keys. OPENROUTER_MODEL must be an OpenRouter
# model slug, e.g. anthropic/claude-sonnet-4.5 or openai/gpt-4o -- no default
# is set on purpose, pick the model explicitly. For the crawl feature, both
# vars must ALSO be set via `supabase secrets set` for the run-crawl Edge
# Function, separately from Vercel's env vars (same as ANTHROPIC_API_KEY above).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Workspace (Gmail + Drive delivery, and Sheets / Business Profile for
# Monthly Reports). GOOGLE_CLIENT_ID/SECRET are shared with the separate
# Search Console connect flow (see TOKEN_ENCRYPTION_KEY below), which is what
# GOOGLE_REDIRECT_URI now points at -- add it as an authorized redirect URI
# on this OAuth client in Google Cloud Console.
# GOOGLE_REFRESH_TOKEN (Gmail/Drive/Sheets/GBP only -- GSC uses its own
# DB-stored token, not this one) must be generated with these scopes:
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/drive.file
#   https://www.googleapis.com/auth/spreadsheets.readonly   <- backlinks Sheet pull
#   https://www.googleapis.com/auth/business.manage         <- GBP posts pull (also needs
#                                                                Google's GBP API access approval
#                                                                on the account -- see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain>/api/gsc/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_REPORTS_FOLDER_ID=

# 32-byte key (base64) used to encrypt the Search Console refresh token at
# rest (see lib/tokenCrypto.ts). Generate with: openssl rand -base64 32 -- if
# this ever changes, the stored token becomes unreadable and Search Console
# needs reconnecting via "Connect Search Console" on the Client roster page.
TOKEN_ENCRYPTION_KEY=

# "Upcoming client meetings" card on the Client roster page, above Overview.
# A Google Calendar's "Secret address in iCal format" -- Calendar settings
# for that calendar > Integrate calendar > Secret address in iCal format.
# Treat this like a password: anyone with the URL can read the calendar.
# Leave unset to hide the card entirely.
CLIENT_MEETINGS_ICS_URL=

