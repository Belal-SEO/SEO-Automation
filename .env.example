SCREAMING_FROG_LICENSE_KEY=

# Vercel Cron auth (protects /api/cron/*)
CRON_SECRET=

# Alerting (e.g. Slack incoming webhook) for alert-check
ALERT_WEBHOOK_URL=

# Google Workspace (Gmail + Drive delivery)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_REPORTS_FOLDER_ID=
